#!/bin/sh
# The deployment agent on lab-control (proposal 0013 §10.2 and §10.4 D,
# D-107): brings staging to the newest internal development build. Run by
# blentinel-deploy-agent.timer as the user `deployer`; never by hand as root.
#
# Each run, one build at a time, under a lock:
#   1. finish a build an earlier run left unfinished, from the step it reached;
#   2. otherwise ask GitHub (outbound HTTPS only) for the newest successful
#      push to main of the Build workflow with a staging-<version> artifact,
#      and ask staging what it runs; stop if staging is on it or newer, or if
#      that build was tried already. If staging changed without the agent
#      (rebuilt, say), the newest build goes back on, once, if it deployed
#      well before; one that failed is never tried again;
#   3. download it into an empty folder, unpack it flat (unzip-release.py),
#      and verify it with the staging keys pinned in agent.conf, never with a
#      key from the download (verify-release.sh): its release.json must name
#      the run's commit and the artifact's version;
#   4. write the record (0013 §6.4) and create the GitHub Deployment for that
#      exact commit, environment staging;
#   5. send the release to staging over SSH, where the key can only run the
#      forced command: verified again there, installed or upgraded, approved;
#   6. smoke tests: staging's hub runs the release's own hub program, on the
#      version, and answers on HTTPS with the key staging says it serves;
#   7. report: the Deployment's status, and one line in deployments.log.
#
# Each step's result is kept in builds/<version>/state before the next one
# starts, so a run that was cut short resumes where it stopped:
#   downloaded  the artifact is unpacked in files/, not yet verified
#   verified    it verified; the record is written
#   deploying   the Deployment exists; the release is (being) sent to staging
#   installed   staging said it is on the version; smoke tests to come
#   succeeded   the smoke tests passed; to report
#   failed      a step failed for good (see reason); to report
#   reported    GitHub has the outcome: done with this version
# Success is reported only from `succeeded`, so never before the smoke tests
# passed. A version that failed is never tried again: the next merge is the
# fix (roll forward, 0013 §13).
#
# Exit status: 0 done or nothing to do; 1 a deployment failed (reported);
# 75 a passing problem (GitHub or staging unreachable, staging busy): the
# next run carries on from the same step.
set -eu
umask 077

# Written by Ansible, owned by root.
# shellcheck source=/dev/null
. /etc/blentinel-deploy-agent/agent.conf
LIB=/usr/local/lib/blentinel-deploy-agent
STATE=/var/lib/blentinel-deploy-agent
HUB_FILE=hub-x86_64-unknown-linux-musl
VERSION_RE='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$'

log() { printf 'agent: %s\n' "$*" >&2; }
# A problem that may pass: stop now, carry on next run.
later() {
    log "$* (trying again next run)"
    exit 75
}

if [ -n "${RUNTIME_DIRECTORY:-}" ]; then
    RUN=$RUNTIME_DIRECTORY
else
    RUN=$(mktemp -d)
    trap 'rm -rf "$RUN"' EXIT
fi

exec 8>"$STATE/lock"
flock -n 8 || {
    log "another run is under way"
    exit 0
}

# The token goes into a header file only this user can read: never on a
# command line, never in the environment of a child.
token=$(cat "$TOKEN_FILE")
case $token in
"" | *[!A-Za-z0-9_]*) log "the token in $TOKEN_FILE is empty or not a GitHub token" && exit 1 ;;
esac
printf 'Authorization: Bearer %s\nAccept: application/vnd.github+json\nX-GitHub-Api-Version: 2022-11-28\nUser-Agent: blentinel-deploy-agent\n' \
    "$token" >"$RUN/headers"
unset token

# api <method> <path> [<JSON body file>]: the answer on stdout; fails on an
# error, having logged it.
api() {
    if [ $# -eq 3 ]; then
        set -- "$1" "$2" -H 'Content-Type: application/json' --data-binary "@$3"
    fi
    method=$1 path=$2
    shift 2
    code=$(curl -sS --max-time 60 -o "$RUN/response" -w '%{http_code}' -X "$method" \
        -H "@$RUN/headers" "$@" "$API_URL$path") || {
        log "can't reach $API_URL ($method $path)"
        return 1
    }
    case $code in
    2??) cat "$RUN/response" ;;
    *)
        log "GitHub answered $code to $method $path: $(head -c 300 "$RUN/response")"
        return 1
        ;;
    esac
}

set_state() {
    printf '%s\n' "$2" >"$1/state.new"
    mv "$1/state.new" "$1/state"
    log "$(basename "$1"): $2"
}
fail_build() { # <dir> <reason> <message>
    printf '%s\n%s\n' "$2" "$3" >"$1/reason"
    set_state "$1" failed
}
meta() { jq -r ".$2" "$1/meta.json"; }

# newer A B: A is a later version than B (dev builds: by their number).
newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]; }

ssh_staging() {
    ssh -F /dev/null -i "$SSH_KEY" -o BatchMode=yes -o IdentitiesOnly=yes \
        -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$KNOWN_HOSTS" \
        -o GlobalKnownHostsFile=/dev/null -o ConnectTimeout=15 \
        -o ServerAliveInterval=15 -o ServerAliveCountMax=8 \
        "$STAGING_USER@$STAGING_HOST" "$1"
}
value() { sed -n "s/^$1=//p" "$2" | head -n 1; }

# --- 2. The newest candidate, into $RUN/candidate: "<run id> <run number>
# <commit> <artifact id> <version>", or empty. Not run in a subshell, so
# that `later` stops the whole run.
candidate() {
    : >"$RUN/candidate"
    api GET "/repos/$REPOSITORY/actions/workflows/$WORKFLOW/runs?branch=main&event=push&status=success&per_page=10" \
        >"$RUN/runs.json" || later "can't list the Build runs"
    # GitHub's branch filter is only a filter: each run is checked again.
    jq -r '.workflow_runs | sort_by(-.run_number) | .[]
        | select(.head_branch == "main" and .event == "push" and .conclusion == "success")
        | "\(.id) \(.run_number) \(.head_sha)"' "$RUN/runs.json" >"$RUN/runs"
    while read -r run number commit; do
        api GET "/repos/$REPOSITORY/actions/runs/$run/artifacts?per_page=100" >"$RUN/artifacts.json" ||
            later "can't list the artifacts of run $run"
        found=$(jq -r '[.artifacts[] | select((.name | startswith("staging-")) and (.expired | not))]
            | first // empty | "\(.id) \(.name)"' "$RUN/artifacts.json")
        [ -n "$found" ] || continue
        artifact=${found%% *}
        version=${found#* staging-}
        echo "$run $number" | grep -Eq '^[0-9]+ [0-9]+$' || { log "run $run: odd numbers, skipped" && continue; }
        echo "$commit" | grep -Eq '^[0-9a-f]{40}$' || { log "run $run: odd commit, skipped" && continue; }
        echo "$artifact" | grep -Eq '^[0-9]+$' || { log "run $run: odd artifact id, skipped" && continue; }
        echo "$version" | grep -Eq "$VERSION_RE" || { log "run $run: $found isn't staging-<version>, skipped" && continue; }
        echo "$run $number $commit $artifact $version" >"$RUN/candidate"
        return 0
    done <"$RUN/runs"
    return 0
}

# --- 3. Download and unpack: state `downloaded`.
download() { # <dir>
    dir=$1
    artifact=$(meta "$dir" artifact_id)
    # GitHub answers with a redirect to its storage: followed without the
    # token, which is for GitHub's API only.
    location=$(curl -sS --max-time 60 -o /dev/null -w '%{redirect_url}' -H "@$RUN/headers" \
        "$API_URL/repos/$REPOSITORY/actions/artifacts/$artifact/zip") || later "can't ask for artifact $artifact"
    case $location in
    "${API_URL%%://*}://"*) ;;
    *) later "artifact $artifact: no download address" ;;
    esac
    curl -sS --fail --max-time 900 --max-filesize "$MAX_ARTIFACT_BYTES" -o "$dir/artifact.zip" "$location" ||
        later "can't download artifact $artifact"
    rm -rf "$dir/files"
    mkdir "$dir/files"
    if ! python3 -I "$LIB/unzip-release.py" "$dir/artifact.zip" "$dir/files"; then
        rm -f "$dir/artifact.zip"
        fail_build "$dir" verification "the artifact isn't a release folder"
        return
    fi
    rm -f "$dir/artifact.zip"
    set_state "$dir" downloaded
}

# --- 3. Verify, with the pinned keys: state `verified`, with the record.
verify() { # <dir>
    dir=$1
    key=
    for candidate_key in $STAGING_KEYS; do
        if sh "$LIB/verify-release.sh" "$dir/files" "$candidate_key" 2>"$RUN/verify.err"; then
            key=$candidate_key
            break
        fi
    done
    if [ -z "$key" ]; then
        fail_build "$dir" verification "not signed by a pinned staging key: $(tail -n 1 "$RUN/verify.err")"
        return
    fi
    version=$(meta "$dir" version)
    commit=$(meta "$dir" commit)
    [ "$(jq -r .version "$dir/files/release.json")" = "$version" ] || {
        fail_build "$dir" verification "release.json's version isn't the artifact's ($version)"
        return
    }
    [ "$(jq -r .commit "$dir/files/release.json")" = "$commit" ] || {
        fail_build "$dir" verification "release.json's commit isn't the run's ($commit)"
        return
    }
    grep -q "  \*\?$HUB_FILE\$" "$dir/files/SHA256SUMS" || {
        fail_build "$dir" verification "the release has no $HUB_FILE"
        return
    }
    # The record (0013 §6.4): what was verified, byte for byte.
    tar -xzOf "$dir/files/probes.tar.gz" manifest.json >"$RUN/manifest.json"
    awk '{ sub(/^\*/, "", $2); print $2 "\t" $1 }' "$dir/files/SHA256SUMS" |
        jq -R 'split("\t") | {(.[0]): .[1]}' | jq -s add >"$RUN/files.json"
    jq -n --slurpfile meta "$dir/meta.json" --slurpfile files "$RUN/files.json" \
        --slurpfile manifest "$RUN/manifest.json" \
        --arg sums "$(sha256sum "$dir/files/SHA256SUMS" | cut -d' ' -f1)" --arg key "$key" \
        --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{
            agent: "blentinel-deploy-agent",
            version: $meta[0].version, commit: $meta[0].commit,
            run_id: $meta[0].run_id, run_number: $meta[0].run_number, artifact_id: $meta[0].artifact_id,
            sha256sums: $sums, signed_with: $key, verified_at: $at,
            files: $files[0],
            probes: ($manifest[0].artifacts | map({(.file): .sha256}) | add)
        }' >"$dir/record.json"
    set_state "$dir" verified
}

# The Deployment for this build, made once: an earlier run cut short after
# making it is found again by its attempt's nonce, saved before it was made
# (the same version deployed again later is a new attempt, a new Deployment).
deployment() { # <dir>
    dir=$1
    if [ -s "$dir/deployment" ]; then
        cat "$dir/deployment"
        return 0
    fi
    version=$(meta "$dir" version)
    commit=$(meta "$dir" commit)
    [ -s "$dir/nonce" ] || od -An -N16 -tx1 /dev/urandom | tr -d ' \n' >"$dir/nonce"
    nonce=$(cat "$dir/nonce")
    api GET "/repos/$REPOSITORY/deployments?sha=$commit&environment=staging&per_page=100" >"$RUN/found.json" ||
        return 1
    id=$(jq -r --arg n "$nonce" '[.[] | select(.payload.agent? == "blentinel-deploy-agent"
        and .payload.nonce? == $n)] | first // empty | .id' "$RUN/found.json")
    if [ -z "$id" ]; then
        if [ -s "$dir/record.json" ]; then cp "$dir/record.json" "$RUN/payload.json"; else
            jq '{agent: "blentinel-deploy-agent", version, commit, run_id, run_number, artifact_id}' \
                "$dir/meta.json" >"$RUN/payload.json"
        fi
        jq --arg n "$nonce" '. + {nonce: $n}' "$RUN/payload.json" >"$RUN/payload.new"
        mv "$RUN/payload.new" "$RUN/payload.json"
        jq -n --arg sha "$commit" --arg v "$version" --slurpfile payload "$RUN/payload.json" '{
            ref: $sha, environment: "staging", auto_merge: false, required_contexts: [],
            transient_environment: false, production_environment: false, task: "deploy",
            description: ("Blentinel " + $v + ", internal development build"),
            payload: $payload[0]}' >"$RUN/create.json"
        api POST "/repos/$REPOSITORY/deployments" "$RUN/create.json" >"$RUN/created.json" || return 1
        id=$(jq -r .id "$RUN/created.json")
        [ "$(jq -r .sha "$RUN/created.json")" = "$commit" ] || {
            log "GitHub's Deployment $id names $(jq -r .sha "$RUN/created.json"), not $commit"
            return 1
        }
    fi
    echo "$id" | grep -Eq '^[0-9]+$' || return 1
    echo "$id" >"$dir/deployment"
    echo "$id"
}

post_status() { # <dir> <state> <description>
    id=$(deployment "$1") || return 1
    jq -n --arg s "$2" --arg d "$3" '{state: $s, description: ($d | .[0:140]),
        environment: "staging", auto_inactive: true}' >"$RUN/status.json"
    api POST "/repos/$REPOSITORY/deployments/$id/statuses" "$RUN/status.json" >/dev/null
}

# --- 4 and 5. To staging: state `installed`.
send() { # <dir>
    dir=$1
    if [ ! -e "$dir/started" ]; then
        post_status "$dir" in_progress "Sending $(meta "$dir" version) to staging" ||
            later "can't make the Deployment"
        : >"$dir/started"
    fi
    attempts=$(($(cat "$dir/attempts" 2>/dev/null || echo 0) + 1))
    echo "$attempts" >"$dir/attempts"
    set +e
    (cd "$dir/files" && tar -cf - -- *) | ssh_staging deploy >"$dir/deploy.out" 2>"$dir/deploy.err"
    status=$?
    set -e
    cat "$dir/deploy.err" >&2
    case $status in
    0)
        if [ "$(value result "$dir/deploy.out")" = deployed ] &&
            [ "$(value version "$dir/deploy.out")" = "$(meta "$dir" version)" ]; then
            set_state "$dir" installed
        else
            fail_build "$dir" install "staging answered, but not that it is on $(meta "$dir" version)"
        fi
        ;;
    65) fail_build "$dir" refused "staging refused the release: $(tail -n 1 "$dir/deploy.err")" ;;
    70) fail_build "$dir" rolled-back "hub upgrade failed on staging and put the old hub back: $(value version "$dir/deploy.out") is not running" ;;
    71) fail_build "$dir" install "the install on staging failed: $(tail -n 1 "$dir/deploy.err")" ;;
    *)
        # 75 (busy), 255 (no connection) or the connection lost on the way:
        # staging finishes or refuses on its own, and the next run asks again.
        if [ "$attempts" -ge "$MAX_ATTEMPTS" ]; then
            fail_build "$dir" unreachable "no answer from staging after $attempts tries (last: $status)"
            return
        fi
        later "staging didn't finish the deployment (status $status, try $attempts of $MAX_ATTEMPTS)"
        ;;
    esac
}

# --- 6. Smoke tests: state `succeeded`, or `failed` with what was wrong.
smoke() { # <dir>
    dir=$1
    version=$(meta "$dir" version)
    expected=$(jq -r --arg f "$HUB_FILE" '.files[$f]' "$dir/record.json")
    deadline=$(($(date +%s) + SMOKE_SECONDS))
    while :; do
        problem=
        if ! ssh_staging status </dev/null >"$RUN/status" 2>"$RUN/status.err"; then
            problem="no status from staging: $(tail -n 1 "$RUN/status.err")"
        elif [ "$(value version "$RUN/status")" != "$version" ]; then
            problem="the hub's program is $(value version "$RUN/status"), not $version"
        elif [ "$(value active "$RUN/status")" != active ]; then
            problem="the hub's service is $(value active "$RUN/status")"
        elif [ "$(value running_sha256 "$RUN/status")" != "$expected" ]; then
            problem="the running hub isn't the release's $HUB_FILE"
        else
            pin=$(value tls_pin "$RUN/status")
            case $pin in
            sha256//*)
                # The hub's certificate is its own, self-signed: what proves
                # it is staging's hub is the key, as staging reported it.
                code=$(curl -sS -k --pinnedpubkey "$pin" --max-time 10 -o /dev/null -w '%{http_code}' \
                    "$HUB_URL/api/setup" 2>"$RUN/curl.err") || code=
                [ "$code" = 200 ] || problem="$HUB_URL/api/setup answered '${code:-nothing}' $(tail -n 1 "$RUN/curl.err")"
                ;;
            *) problem="the hub serves no HTTPS yet" ;;
            esac
        fi
        if [ -z "$problem" ]; then
            jq --arg v "$(value version "$RUN/status")" --arg sha "$(value running_sha256 "$RUN/status")" \
                --arg action "$(value action "$dir/deploy.out")" \
                '. + {staging: {version: $v, running_sha256: $sha, action: $action}}' \
                "$dir/record.json" >"$RUN/record.json"
            mv "$RUN/record.json" "$dir/record.json"
            set_state "$dir" succeeded
            return
        fi
        if [ "$(date +%s)" -ge "$deadline" ]; then
            fail_build "$dir" smoke "smoke tests failed for ${SMOKE_SECONDS}s: $problem"
            return
        fi
        sleep 5
    done
}

# --- 7. Report: state `reported`.
report() { # <dir>
    dir=$1
    version=$(meta "$dir" version)
    if [ "$(cat "$dir/state")" = succeeded ]; then
        result=success description="Blentinel $version runs on staging; smoke tests passed"
    else
        result=failure description="$(sed -n 2p "$dir/reason")"
    fi
    post_status "$dir" "$result" "$description" || later "can't report $version to GitHub"
    reason=$(head -n 1 "$dir/reason" 2>/dev/null || true)
    record=$dir/record.json
    [ -s "$record" ] || record=$dir/meta.json
    jq -c --arg r "$result" --arg why "$reason" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg d "$(cat "$dir/deployment")" \
        '. + {result: $r, reason: (if $why == "" then null else $why end), finished_at: $at, deployment: ($d | tonumber)}' \
        "$record" >>"$STATE/deployments.log"
    if [ "$result" = success ]; then
        echo "$version" >"$STATE/current"
    fi
    set_state "$dir" reported
    log "$version: $result ($description)"
    [ "$result" = success ]
}

# Every step a build still needs, in order, from where it stands.
carry_on() { # <dir>
    dir=$1
    while :; do
        case $(cat "$dir/state" 2>/dev/null || echo new) in
        new) download "$dir" ;;
        downloaded) verify "$dir" ;;
        verified)
            set_state "$dir" deploying
            ;;
        deploying) send "$dir" ;;
        installed) smoke "$dir" ;;
        succeeded | failed)
            report "$dir" || return 1
            return 0
            ;;
        reported) return 0 ;;
        *)
            log "$dir: unknown state $(cat "$dir/state")"
            return 1
            ;;
        esac
    done
}

mkdir -p "$STATE/builds"

# --- 1. Unfinished first (at most one: runs hold the lock).
for dir in "$STATE"/builds/*; do
    [ -d "$dir" ] || continue
    if [ ! -s "$dir/meta.json" ]; then
        rm -rf "$dir" # cut short before it was even described
        continue
    fi
    state=$(cat "$dir/state" 2>/dev/null || echo new)
    [ "$state" = reported ] && continue
    log "$(basename "$dir"): carrying on from '$state'"
    carry_on "$dir" || exit 1
done

# --- 2. Anything new?
candidate
found=$(cat "$RUN/candidate")
if [ -z "$found" ]; then
    log "no internal development build on GitHub"
    exit 0
fi
# shellcheck disable=SC2086 # five words, each checked in candidate()
set -- $found
run=$1 number=$2 commit=$3 artifact=$4 version=$5
dir=$STATE/builds/$version

# What staging runs, asked every time: staging may have changed without the
# agent (rebuilt from nothing, a hub installed by hand).
ssh_staging status </dev/null >"$RUN/staging" 2>"$RUN/staging.err" ||
    later "no status from staging: $(tail -n 1 "$RUN/staging.err")"
on_staging=$(value version "$RUN/staging")
current=$(cat "$STATE/current" 2>/dev/null || echo none)
if [ "$on_staging" != "$current" ]; then
    log "staging is on $on_staging, but the agent last deployed $current: staging changed without it"
    echo "$on_staging" >"$STATE/current"
    current=$on_staging
    # The newest build, if it was deployed well before, goes back on once.
    # One that failed is never tried again, whatever happened to staging.
    if [ "$(cat "$dir/state" 2>/dev/null)" = reported ] && [ ! -e "$dir/reason" ]; then
        log "deploying $version again"
        rm -rf "$dir"
    fi
fi
if [ "$on_staging" = "$version" ]; then
    log "staging is on the newest build, $version (run $number)"
    exit 0
fi
if [ -e "$dir/state" ]; then
    log "newest build $version (run $number): done already ($(head -n 1 "$dir/reason" 2>/dev/null || echo deployed))"
    exit 0
fi
case $current in
none | unknown) ;;
*)
    if ! newer "$version" "$current"; then
        log "newest build $version (run $number) isn't newer than staging's $current"
        exit 0
    fi
    ;;
esac
log "newest build $version (run $number, $commit): deploying"
rm -rf "$dir"
mkdir -p "$dir"
jq -n --arg run "$run" --arg number "$number" --arg commit "$commit" --arg artifact "$artifact" \
    --arg version "$version" '{run_id: ($run | tonumber), run_number: ($number | tonumber),
        commit: $commit, artifact_id: ($artifact | tonumber), version: $version}' >"$dir/meta.json"
carry_on "$dir" || status=1

# Keep the folders of the last builds, and the files of the newest three.
# shellcheck disable=SC2012 # the names are versions: no spaces or newlines
ls -1t "$STATE/builds" | tail -n +11 | while read -r old; do rm -rf "${STATE:?}/builds/$old"; done
# shellcheck disable=SC2012 # the same
ls -1t "$STATE/builds" | tail -n +4 | while read -r old; do rm -rf "${STATE:?}/builds/$old/files"; done
exit "${status:-0}"
