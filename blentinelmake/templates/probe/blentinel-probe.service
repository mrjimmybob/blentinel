[Unit]
Description=Blentinel Probe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The probe keeps all its state (identity, config, buffer, log) next to its binary.
ExecStart=/opt/blentinel-probe/probe
WorkingDirectory=/opt/blentinel-probe
User=blentinel
Group=blentinel
# Ping (ICMP) needs raw sockets; this grants only that, even as a normal user.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
