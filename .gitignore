# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
/target
debug/
# rustfmt backups
**/*.rs.bk
# MSVC debug information
*.pdb
# blentinelmake packages
/publish/
# LaTeX build output (the manual is generated from docs/, D-09)
manual/*.aux
manual/*.log
manual/*.out
manual/*.toc
manual/*.pdf

# ---------------------------------------------------------------------------
# Runtime state and SECRETS: created by running a hub or probe from the repo.
# Never commit these (CLAUDE.md, ENGINEERING.md).
# ---------------------------------------------------------------------------
# Identity keys (hub X25519, probe Ed25519) and the hub admin token
*.key
*.token
# First-run setup code of a hub (proposal 0001)
setup.code
# TLS private keys
*_key.pem
hub_tls_*.pem
# Databases (hub data, probe offline buffer)
*.db
*.db-shm
*.db-wal
# Logs
*.log
# Local hub config (contains paths and the probe whitelist)
/blentinel_hub.toml
/hub/blentinel_hub.toml
/probe/blentinel_probe.toml

# The ops inventory and its secrets live on lab-control, never in Git (D-105)
/ops/inventory/
*.vault
vault*.yml

resume*.bat

# ---------------------------------------------------------------------------
# Editor / local leftovers
# ---------------------------------------------------------------------------
*.bak

# ---------------------------------------------------------------------------
# Retired local docs (never tracked; content now in docs/, M0-12). Safe to delete.
# ---------------------------------------------------------------------------
HOT_RELOAD_TESTING.md
HTTPS_IMPLEMENTATION.md
HTTPS_SETUP_GUIDE.md
PROGRESS.md
tree.txt

# Retired by M2-01 (probes pin the hub certificate from their enrollment code)
probe/hub_cert.pem

# CI Backups (atlas and staging)
/backups/
